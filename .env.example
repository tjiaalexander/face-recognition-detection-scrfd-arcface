# Salin menjadi .env lalu sesuaikan. Jangan commit .env.
ADMIN_USERNAME=admin
# Buat hash dengan: python -m scripts.hash_password   (disarankan)
ADMIN_PASSWORD_HASH=
# Alternatif untuk pengembangan lokal saja:
ADMIN_PASSWORD=

# Model: antelopev2 (default) atau buffalo_l
MODEL_NAME=antelopev2
# auto | cpu | cuda
ONNX_PROVIDERS=auto

# BELUM dikalibrasi. Jalankan scripts/calibrate_threshold.py --apply untuk menimpa nilai ini.
RECOGNITION_THRESHOLD=0.45

# Retensi data (hari). 0 = nonaktif.
RETENTION_DAYS=0

# Kosongkan agar dibuat otomatis di data/ (cadangkan berkas tersebut!)
EMBEDDING_KEY=
JWT_SECRET=

LOG_LEVEL=INFO
